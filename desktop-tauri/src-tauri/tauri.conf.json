{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "DS Estimate",
  "version": "0.3.0",
  "identifier": "pl.dsestimate.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "DS Estimate",
        "width": 1280,
        "height": 820,
        "minWidth": 640,
        "minHeight": 480,
        "label": "main",
        "dragDropEnabled": true
      }
    ]
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico"
    ],
    "resources": {
      "cad-backend/ds-cad-engine.exe": "cad-backend/ds-cad-engine.exe"
    }
  }
}
